    "Not enough data to draw %@ for %@. The ECB publishes rates on working days only.": {
      "comment": "History empty state: fewer than two days of rates. First argument is a pair like 'USD → EUR', second a period like '1 week'",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно данных, чтобы построить график %1$@ за %2$@. ЕЦБ публикует курсы только в рабочие дни."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Not enough data to draw %1$@ for %2$@. The ECB publishes rates on working days only."
          }
        }
      }
    },
