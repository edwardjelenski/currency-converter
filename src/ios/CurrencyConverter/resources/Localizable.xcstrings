    "There are no %@ rates for %@. The currency may not have been published by the ECB in this period.": {
      "comment": "History empty state: no rates at all. First argument is a pair like 'USD → EUR', second a period like '1 month'",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курсов %1$@ за %2$@. Возможно, ЕЦБ не публиковал эту валюту в этот период."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "There are no %1$@ rates for %2$@. The currency may not have been published by the ECB in this period."
